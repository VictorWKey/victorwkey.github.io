---
import { useTranslations } from '../i18n/index.js'
import Python from "../icons/Python.jsx";
import Pytorch from "../icons/Pytorch.jsx";
import HuggingFace from "../icons/HuggingFace.jsx";
import LangChain from "../icons/LangChain.jsx";
import Electron from "../icons/Electron.jsx";
import ReactLogo from "../icons/ReactLogo.jsx";
import TypeScript from "../icons/TypeScript.jsx";
import Tailwind from "../icons/Tailwind.jsx";

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const PROJECTS = [
  {
    title: t.featuredProjects.items[0].title,
    desc: t.featuredProjects.items[0].desc,
    technologies: [
      { name: "Python", logo: Python },
      { name: "PyTorch", logo: Pytorch },
      { name: "Hugging Face", logo: HuggingFace },
      { name: "LangChain", logo: LangChain },
      { name: "Electron", logo: Electron },
      { name: "React", logo: ReactLogo },
      { name: "TypeScript", logo: TypeScript },
      { name: "Tailwind", logo: Tailwind },
    ],
    img: "/tourlyai-1920x1080.png",
    repository: "https://github.com/TourlyAI",
    site: "https://tourlyai.site",
  }
];
---

<section id="featured-projects" class="w-full py-12 sm:py-16 px-6 bg-gray-50 dark:bg-night-section">
  <div class="w-full max-w-4xl mx-auto">
    <h2 class="section-heading text-center mb-3 text-gray-900 dark:text-night-heading">{t.featuredProjects.sectionTitle}</h2>
    <p class="section-subheading text-center mb-8">{t.featuredProjects.sectionSubtitle}</p>
    {PROJECTS.map((project) => (
      <article class="card p-5 sm:p-6">
        <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-6 items-center">
          <figure class="w-full max-w-xs mx-auto lg:max-w-none aspect-video rounded-lg border border-gray-200 dark:border-night-line bg-gray-100 dark:bg-night-surface overflow-hidden">
            <img class="w-full h-full object-contain" src={project.img} alt={project.title} width="1920" height="1080" loading="lazy" decoding="async" />
          </figure>
          <div class="min-w-0">
            <h3 class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-night-heading mb-2">{project.title}</h3>
            <p class="text-sm text-gray-600 dark:text-night-body leading-relaxed mb-4">{project.desc}</p>
            <div class="flex flex-wrap gap-3">
              <a href={project.site} class="btn-primary text-sm" target="_blank" rel="noopener noreferrer">{t.featuredProjects.liveDemo}<span class="sr-only"> ({lang === 'es' ? 'nueva pestaña' : 'new tab'})</span></a>
              <a href={project.repository} class="btn-secondary text-sm" target="_blank" rel="noopener noreferrer">{t.featuredProjects.repository}<span class="sr-only"> ({lang === 'es' ? 'nueva pestaña' : 'new tab'})</span></a>
            </div>
          </div>
        </div>
        <div class="mt-5 flex flex-wrap gap-1.5">
          {project.technologies.map((tech) => {
            const Icon = tech.logo;
            return <span class="inline-flex items-center gap-1.5 bg-gray-100 dark:bg-night-raised rounded-lg px-2 py-1 text-xs text-gray-700 dark:text-night-body"><span class="w-3.5 h-3.5" aria-hidden="true"><Icon /></span>{tech.name}</span>;
          })}
        </div>
      </article>
    ))}
  </div>
</section>

---
import LinkedInWhite from '../icons/LinkedInWhite.jsx'
import EmailWhite from '../icons/EmailWhite.jsx'
import GithubWhite from '../icons/GithubWhite.jsx'
import CVDownloadModal from './CVDownloadModal.jsx'
import { useTranslations } from '../i18n/index.js'

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const emailButton = document.getElementById('email-button');
    const email = 'victorwkey@gmail.com';
    const copiedText = emailButton?.getAttribute('data-copied') || 'Copied!';
    
    if (emailButton) {
      emailButton.addEventListener('click', async function() {
        const textElements = emailButton.querySelectorAll('p');
        const visibleElement = Array.from(textElements).find(el => el.offsetParent !== null);
        if (!visibleElement) return;
        
        const originalText = visibleElement.textContent;
        
        try {
          await navigator.clipboard.writeText(email);
          visibleElement.textContent = copiedText;
          setTimeout(() => {
            if (visibleElement) visibleElement.textContent = originalText;
          }, 2000);
        } catch (err) {
          const textArea = document.createElement('textarea');
          textArea.value = email;
          document.body.appendChild(textArea);
          textArea.select();
          document.execCommand('copy');
          document.body.removeChild(textArea);
          visibleElement.textContent = copiedText;
          setTimeout(() => {
            if (visibleElement) visibleElement.textContent = originalText;
          }, 2000);
        }
      });
    }
  });
</script>

<header id="top" class="w-full min-h-[min(760px,100svh)] flex justify-center items-center pt-28 px-6 sm:px-8 pb-16 bg-white dark:bg-night-canvas">
  <div class="w-full max-w-3xl flex flex-col items-center text-center gap-6">
    
    <!-- Profile Image -->
    <figure class="w-36 h-36 sm:w-40 sm:h-40 rounded-full overflow-hidden border-2 border-gray-200 dark:border-night-line">
      <img
        src="/img/pp-official.jpeg"
        alt={t.header.profileAlt}
        width="160"
        height="160"
        class="object-cover w-full h-full"
      >
    </figure>

    <!-- Name & Badge -->
    <div class="flex flex-col items-center gap-3">
      <div class="flex items-center gap-3 flex-wrap justify-center">
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-night-heading tracking-tight">
          Victor López
        </h1>
        <a
          href="https://www.linkedin.com/in/victorlopezwk"
          class="inline-flex items-center text-primary dark:text-night-accent text-xs font-medium px-2.5 py-1 rounded-full border border-primary/30 dark:border-night-accent/40 bg-primary-50 dark:bg-night-surface hover:bg-primary-100 dark:hover:bg-night-raised transition-colors duration-200"
          target="_blank"
          rel="noopener"
        >
          <div class="w-1.5 h-1.5 bg-primary dark:bg-night-accent rounded-full mr-1.5 animate-pulse"></div>
          {t.header.available}
        </a>
      </div>

      <h2 class="text-lg sm:text-xl font-medium text-gray-600 dark:text-night-muted">{t.header.role}</h2>
    </div>

    <!-- Description -->
    <div class="space-y-4 max-w-2xl">
      <p class="text-base sm:text-lg text-gray-700 dark:text-night-body leading-relaxed">{t.header.summary}</p>
      <p class="text-sm sm:text-base text-gray-500 dark:text-night-muted leading-relaxed">{t.header.approach}</p>
    </div>

    <!-- Action Buttons -->
    <div class="flex gap-3 flex-wrap justify-center">
      <a
        href="https://github.com/VictorWKey"
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border border-gray-200 dark:border-night-line text-gray-700 dark:text-night-body bg-white dark:bg-night-surface hover:bg-gray-50 dark:hover:bg-night-raised transition-colors duration-200"
        target="_blank"
        rel="noopener"
      >
        <div class="w-4 h-4"><GithubWhite/></div>
        GitHub
      </a>

      <a
        href="https://www.linkedin.com/in/victorlopezwk"
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border border-gray-200 dark:border-night-line text-gray-700 dark:text-night-body bg-white dark:bg-night-surface hover:bg-gray-50 dark:hover:bg-night-raised transition-colors duration-200"
        target="_blank"
        rel="noopener"
      >
        <div class="w-4 h-4"><LinkedInWhite/></div>
        LinkedIn
      </a>

      <button
        id="email-button"
        data-copied={t.header.copied}
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border border-gray-200 dark:border-night-line text-gray-700 dark:text-night-body bg-white dark:bg-night-surface hover:bg-gray-50 dark:hover:bg-night-raised transition-colors duration-200 cursor-pointer"
        title={t.header.copyEmail}
        aria-label={t.header.copyEmail}
      >
        <div class="w-4 h-4"><EmailWhite/></div>
        <p class="hidden sm:block">victorwkey@gmail.com</p>
        <p class="sm:hidden">{t.header.email}</p>
      </button>

      <CVDownloadModal lang={lang} client:load />
    </div>
  </div>
</header>
